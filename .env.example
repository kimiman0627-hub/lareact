APP_NAME=KRLived
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# 파일 저장소: LOCAL | NCP | R2
FILE_STORAGE=LOCAL

# 크롤링 시 동영상도 저장할지 (false = 본문에서 동영상 제거, 이미지만 저장)
CRAWL_SAVE_VIDEOS=false

# Cloudflare R2 (FILE_STORAGE=R2)
# R2_ENDPOINT=https://<계정ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
# Blogger 발행용 공개 버킷 + 연결한 도메인 (예: https://img.example.com)
R2_PUBLIC_BUCKET=
R2_PUBLIC_URL=

# 네이버 클라우드 Object Storage (FILE_STORAGE=NCP)
NCP_STORAGE_ACCESS_KEY=
NCP_STORAGE_SECRET_KEY=
NCP_STORAGE_BUCKET=
NCP_CDN_URL=

VITE_APP_NAME="${APP_NAME}"

KAKAO_JS_KEY=

# Google Blogger
BLOGGER_CLIENT_ID=
BLOGGER_CLIENT_SECRET=
BLOGGER_REFRESH_TOKEN=
BLOGGER_BLOG_ID=

# Anthropic (AI 요약)
ANTHROPIC_API_KEY=
